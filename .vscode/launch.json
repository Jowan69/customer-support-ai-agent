{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "run_offline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_offline.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        },
        {
            "name": "run_online",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_online.py",
            "args": ["--limit", "20"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        },
        {
            "name": "pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        }
    ]
}
